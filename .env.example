# ===== Hy3 模型接入：两种方式任选其一 =====

# 方式 A（推荐）：官方 API Token，无需 GPU / 本地部署
# 通过腾讯混元官方 OpenAI 兼容 API 调用（Token 在官方控制台申请，sk- 开头）
# 注意：Hy3 是推理模型，思考过程也消耗 max_tokens，请按下方分层建议设置生成长度
HY3_API_BASE=https://tokenhub.tencentmaas.com/v1
HY3_MODEL_NAME=hy3
HY3_API_KEY=your_official_api_token

# 方式 B：自部署 vLLM OpenAI 兼容服务
# HY3_API_BASE=http://0.0.0.0:8002/v1
# HY3_MODEL_NAME=hy3-gptq-int4
# HY3_API_KEY=dummy

# 本地模型配置（未设置 HY3_API_BASE 时回退到本地加载）
# HY3_MODEL_PATH=/path/to/hy3-gptq-int4
# HY3_TP_SIZE=2
# HY3_MAX_MODEL_LEN=8192

# LLM-as-judge 默认裁判配置（强烈推荐使用外部模型，避免 Hy3 自评虚高）
# 单 judge 模式默认优先使用 JUDGE_GPT_* 配置
# JUDGE_GPT_API_BASE 填你的 OpenAI 兼容 API 网关地址
JUDGE_GPT_API_BASE=https://your-openai-compatible-endpoint/v1
JUDGE_GPT_API_KEY=your_key
JUDGE_GPT_MODEL=gpt-5.6-terra

# 多 judge 交叉复核配置（可选）
# 启用方式：python evaluator/evaluate.py --use_llm --multi_judge
# 多 judge 默认组合：Hy3 + GPT + Gemini；如不需要本地 Hy3 裁判，可只保留 GPT/Gemini
# JUDGE_HY3_API_BASE=http://0.0.0.0:8002/v1
# JUDGE_HY3_API_KEY=dummy
# JUDGE_HY3_MODEL=hy3-gptq-int4

# JUDGE_GEMINI_API_BASE=https://your-openai-compatible-endpoint/v1
# JUDGE_GEMINI_API_KEY=your_key
# JUDGE_GEMINI_MODEL=gemini-3-flash-preview
